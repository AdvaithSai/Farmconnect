# Frontend settings. Copy to .env and fill in.
# Everything starting with VITE_ is shipped to the browser: no secrets here.

# Firebase web app config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public URL of the backend in otp-backend/ (payments, password reset, assistant)
VITE_BACKEND_URL=http://localhost:3000

# Backend secrets. Copy to .env and fill in. Never commit the real file.

PORT=3000

# Gmail account that sends password-reset codes (use an app password, not the account password)
GMAIL_USER=
GMAIL_PASS=

# Firebase service account (Firebase console > Project settings > Service accounts)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes and the \n sequences exactly as they appear in the downloaded JSON
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Razorpay key pair (use test-mode keys while developing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: enables AI answers in the assistant. Without it the assistant
# answers from its built-in help articles.
GEMINI_API_KEY=
# Optional: defaults to gemini-2.5-flash
GEMINI_MODEL=
